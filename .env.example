NUXT_ML_BASE_URL=http://ml:8080
NUXT_ML_TIMEOUT_MS=2800
NUXT_PUBLIC_DEMO_SCAN=false
NUXT_ML_FALLBACK=
NUXT_PUBLIC_LITE_SCAN=false
NUXT_PUBLIC_MOCK_SCAN_HISTORY=false

ML_RELEASE_DIR=./work/release
ML_GALLERY_PATH=/opt/svoe/release/gallery-strict.jsonl
ML_DATA_ROOT=/opt/svoe/release
ML_ADAPTER_PATH=/opt/svoe/release/siglip2-field-adapter.safetensors
ML_CACHE_DIR=/opt/svoe/release/siglip-cache
ML_MODEL_ID=google/siglip2-base-patch16-384
ML_MODEL_REVISION=f775b65a79762255128c981547af89addcfe0f88
ML_PIPELINE=siglip2
ML_DEVICE=cuda
ML_PRECISION=bfloat16
ML_BATCH_SIZE=32
ML_OFFLINE=true
ML_MAX_UPLOAD_MB=12
ML_TOP_K=5

# Fill all four only after real-photo calibration.
ML_NOT_FOUND_SCORE_THRESHOLD=
ML_MATCHED_SCORE_THRESHOLD=
ML_MATCHED_MARGIN_THRESHOLD=
ML_THRESHOLD_VERSION=

BUILD_COMMIT=
RELEASE_ID=

# Temporary local/trusted annotation UI. Keep disabled on public deployments.
NUXT_ANNOTATION_ENABLED=false
ANNOTATION_REPO_ROOT=
