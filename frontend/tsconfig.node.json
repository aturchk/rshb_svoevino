{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Алиас нужен и здесь: тесты импортируют модули приложения,
       которые ссылаются на shared через @/. */
    "paths": { "@/*": ["./src/*"] },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Только точки входа: файлы из src/ подтягиваются транзитивно по импортам.
     Перечислять src/shared целиком нельзя — тогда node-проект начнёт
     компилировать .tsx без JSX. Границы слоёв закреплены зоной в eslint.config.js. */
  "include": ["vite.config.ts", "scripts", "tests"]
}
