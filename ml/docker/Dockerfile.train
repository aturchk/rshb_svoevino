ARG PYTORCH_IMAGE=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
FROM ${PYTORCH_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /workspace/rshb_svoevino
COPY ml/pyproject.toml ml/pyproject.toml
COPY ml/src ml/src
COPY ml/tests ml/tests
COPY ml/scripts ml/scripts
RUN python -m pip install --no-cache-dir -e './ml[siglip,orb,api]'

ENTRYPOINT ["bash", "ml/scripts/runpod_train.sh"]
